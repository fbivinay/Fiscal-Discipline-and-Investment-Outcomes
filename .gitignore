# Third-party Overleaf source clone — not part of this research, 324 MB
overleaf/

# Similarity and AI-detection reports on the manuscript: internal QA, not published
plagiarish and ai/

# Superseded drafts of the manuscript (the current version lives in paper/)
/Fiscal_Discipline_FDI_Paper_REVISED*.docx
/Research_Plan_COMPLETE*.docx

# Word lock files
~$*

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Advisor feedback on the manuscript: private correspondence, not published
/Suggestions and Recommendations.pdf

# LaTeX build artefacts — main.tex is the source, the PDF is rebuilt from it
paper/latex/*.aux
paper/latex/*.log
paper/latex/*.out
paper/latex/*.pdf
!paper/latex/figures/*.pdf

# Scratch output from analysis reruns — regenerate, do not commit
/*_out.txt

# Knowledge-graph cache built by the graphify skill — derived from the tracked
# sources, rebuilt on demand, and hashed per file, so it churns on every run
graphify-out/

# Economics Bulletin build artefacts. The PDF is deliberately NOT ignored here
# (unlike paper/latex/) because it is the file uploaded to the journal.
paper/submission/eb_short/*.aux
paper/submission/eb_short/*.log
paper/submission/eb_short/*.out

# The FC-16 annexures PDF is a 5.6 MB public document, cited in the paper and
# downloadable from indiabudget.gov.in. code/verify_against_fc16.py expects it
# in the project root; it is not redistributed here.
/Vol2-Annexures.pdf

# DPIIT factsheet: public document, not redistributed here
/4128971a6c7fd4a7653ca9e648a5f34b.pdf

# Economics Bulletin author instructions: the journal's own document, downloaded
# from accessecon.com. Compliance against it is recorded in
# paper/submission/eb_short/README.md rather than by redistributing the PDF.
/Economics Bulletin author guildlines-2012.pdf
